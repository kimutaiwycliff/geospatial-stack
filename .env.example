# Copy to .env for local dev. Never commit the real .env (see .gitignore).
# The same file (with real secrets/prod host values) is what runs in production --
# no separate prod config format, per brief §7 "env-based config end to end."

# --- PostGIS -----------------------------------------------------------------
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo_dev_password
POSTGRES_DB=geoplatform
# dbmate needs the full DSN, not the split vars -- kept in lockstep with the three
# vars above by hand since dbmate doesn't compose one from POSTGRES_* itself.
# sslmode=disable is fine: this connection never leaves the Docker network.
DATABASE_URL=postgres://geo:geo_dev_password@db:5432/geoplatform?sslmode=disable

# --- Object storage (S3 API only -- see docker-compose.yml comment) -----------
# Swapping these five vars to Cloudflare R2 values requires zero code changes
# anywhere in etl/ or api/, and lets the `storage` (MinIO) container be dropped
# entirely. That portability is the whole point of the S3-only rule (brief §2).
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=geo_minio_admin
S3_SECRET_KEY=geo_minio_dev_password
S3_BUCKET=geoplatform
S3_REGION=us-east-1
# MinIO's own root creds -- only the `storage` container reads these directly;
# app code always goes through S3_ACCESS_KEY/S3_SECRET_KEY above, which we set
# equal to these for local dev so the same bucket is reachable both ways.
MINIO_ROOT_USER=geo_minio_admin
MINIO_ROOT_PASSWORD=geo_minio_dev_password

# --- Redis (Celery broker + result backend) -----------------------------------
REDIS_URL=redis://redis:6379/0

# --- FastAPI -------------------------------------------------------------------
# Symmetric-key JWT signing for the FastAPI-native auth phase (brief §10).
# Generate a real one for anything beyond local dev: openssl rand -hex 32
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60
# :8080 is Caddy; :5173 is Vite's own dev server (web/vite.config.ts) --
# both are needed for local dev since the frontend calls the API directly
# from whichever origin it's actually running on (see config.ts).
API_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# --- Embedding (brief follow-up: "can another person use the map ... as an
# iframe") ------------------------------------------------------------------
# Space-separated (NOT comma -- this is substituted verbatim into a CSP
# `frame-ancestors` source list, see caddy/Caddyfile, which is itself
# space-separated) list of external origins allowed to embed a PUBLISHED
# Map's shareable page (/m/:slug) in an <iframe>. Every other page in this
# app (the admin dashboard, login, the general /map explorer) stays fully
# blocked from framing regardless of this setting -- clickjacking
# protection for anything that isn't an intentionally-shareable Map.
# Left blank on purpose: an empty CSP source list means "allow no origins"
# (equivalent to 'none'), so embedding stays off until a real partner
# origin is added here. Must include the scheme, no trailing slash, no
# wildcards on the bare domain (e.g. `https://partner.example.org`, not
# `partner.example.org` or `*.example.org` -- CSP does support a leading
# `*.` wildcard subdomain form if that's genuinely needed later).
# Changing this only takes effect once the `proxy` container restarts
# (`docker compose restart proxy` -- no image rebuild needed).
EMBED_ALLOWED_ORIGINS=

# --- Observability (brief §12) -------------------------------------------------
# Grafana's admin login (provisioning covers datasources/dashboards -- see
# ops/grafana/provisioning -- but Grafana still needs *a* credential to log
# into, same as every other service here).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_dev_password
# Sentry DSN for both the API (app/main.py) and worker (worker/celery_app.py).
# Left blank on purpose: there is no Sentry account/project for this client
# yet. sentry_sdk.init() with an empty DSN is a documented no-op (no network
# calls, no crash) -- so leaving this unset is safe, not broken. When the
# client sets up a real Sentry project, paste its DSN here (format:
# https://<key>@<org>.ingest.sentry.io/<project>) and both processes start
# reporting on the next `docker compose up` -- no code change required.
SENTRY_DSN=
# Frontend counterpart (web/src/main.tsx) -- a SEPARATE Sentry project's
# DSN (a JS/browser project, not the Python one above). Same no-op-until-set
# contract, but this one is a Vite BUILD-time value (inlined into the JS
# bundle, not read at container runtime) -- see web/Dockerfile's ARG/ENV
# pair -- so setting this requires rebuilding the `web` image, not just
# restarting the container.
VITE_SENTRY_DSN=
