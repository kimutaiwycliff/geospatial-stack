# Copy to .env for local dev. Never commit the real .env (see .gitignore).
# The same file (with real secrets/prod host values) is what runs in production --
# no separate prod config format, per brief §7 "env-based config end to end."

# --- PostGIS -----------------------------------------------------------------
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo_dev_password
POSTGRES_DB=geoplatform
# dbmate needs the full DSN, not the split vars -- kept in lockstep with the three
# vars above by hand since dbmate doesn't compose one from POSTGRES_* itself.
# sslmode=disable is fine: this connection never leaves the Docker network.
DATABASE_URL=postgres://geo:geo_dev_password@db:5432/geoplatform?sslmode=disable

# --- Object storage (S3 API only -- see docker-compose.yml comment) -----------
# Swapping these five vars to Cloudflare R2 values requires zero code changes
# anywhere in etl/ or api/, and lets the `storage` (MinIO) container be dropped
# entirely. That portability is the whole point of the S3-only rule (brief §2).
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=geo_minio_admin
S3_SECRET_KEY=geo_minio_dev_password
S3_BUCKET=geoplatform
S3_REGION=us-east-1
# MinIO's own root creds -- only the `storage` container reads these directly;
# app code always goes through S3_ACCESS_KEY/S3_SECRET_KEY above, which we set
# equal to these for local dev so the same bucket is reachable both ways.
MINIO_ROOT_USER=geo_minio_admin
MINIO_ROOT_PASSWORD=geo_minio_dev_password

# --- Redis (Celery broker + result backend) -----------------------------------
REDIS_URL=redis://redis:6379/0

# --- FastAPI -------------------------------------------------------------------
# Symmetric-key JWT signing for the FastAPI-native auth phase (brief §10).
# Generate a real one for anything beyond local dev: openssl rand -hex 32
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60
# :8080 is Caddy; :5173 is Vite's own dev server (web/vite.config.ts) --
# both are needed for local dev since the frontend calls the API directly
# from whichever origin it's actually running on (see config.ts).
API_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
